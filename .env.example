# ============================================================
# LLM PROVIDERS
# ============================================================

OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key


# ============================================================
# MODELS
# ============================================================

OPENAI_LOW_MODEL=gpt-5.6-luna
OPENAI_MEDIUM_MODEL=gpt-5.6-terra
OPENAI_HIGH_MODEL=gpt-5.6-sol

ANTHROPIC_MODEL=claude-sonnet-5

# ============================================================
# PERSISTENT APPLICATION STORAGE
# ============================================================

# Must be an absolute path when explicitly configured.
#
# Local development may omit this variable, in which case
# <project>/data is used.
#
# Docker will use:
# DATA_ROOT=/app/data

# DATA_ROOT=/absolute/path/to/data


# ============================================================
# POSTGRESQL
# ============================================================

DB_HOST=localhost
DB_PORT=5432
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name


# ============================================================
# SQL SAFETY
# ============================================================

SQL_STATEMENT_TIMEOUT_MS=10000
SQL_MAX_ROWS=1000


# ============================================================
# API INGESTION
# ============================================================

HTTP_TIMEOUT_SECONDS=30

API_MAX_RESPONSE_BYTES=20000000
API_MAX_TOTAL_RESPONSE_BYTES=100000000

API_MAX_PAGES=50
API_MAX_RECORDS=100000

API_RETRY_TOTAL=4
API_RETRY_BACKOFF_SECONDS=0.5

API_USER_AGENT=autonomous-data-engineer-agent/0.1


# Optional OUTBOUND authentication for external APIs

API_AUTH_TOKEN=
API_AUTH_HEADER=Authorization
API_AUTH_SCHEME=Bearer

API_MAX_REDIRECTS=5


# ============================================================
# AGENT RUNTIME SAFETY
# ============================================================

ETL_MAX_TOOL_CALLS=8
AGENT_REQUEST_TIMEOUT_SECONDS=600


# ============================================================
# DBT
# ============================================================

DBT_TARGET_SCHEMA=dbt_dev
DBT_THREADS=4


# ============================================================
# INBOUND SERVICE API AUTHENTICATION
# ============================================================

# Protects POST /query.
#
# Use a long random secret in real deployments.
# Never commit the real value.

SERVICE_API_KEY=replace_with_a_random_secret_at_least_32_characters